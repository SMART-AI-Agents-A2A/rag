# Service
RAG_HOST=0.0.0.0
RAG_PORT=8080
RAG_API_PORT=8080
RAG_LOG_LEVEL=INFO
RAG_ADMIN_TOKEN=replace-with-your-administrative-token

# Qdrant
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_PORT=6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_TIMEOUT_SECONDS=20
RAG_COLLECTION_NAME=rag_documents

# Canonical corpus
RAG_DOCUMENTS_DIR=documents/rag
RAG_DEFAULT_LANGUAGE=pt-BR
RAG_ALLOWED_LANGUAGES=pt-BR,en,es

# OpenRouter
RAG_OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
RAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_OPENROUTER_TIMEOUT_SECONDS=45
RAG_OPENROUTER_RETRY_ATTEMPTS=3
RAG_EMBEDDING_MODEL=baai/bge-m3
RAG_EMBEDDING_DIMENSION=1024

# Retrieval
RAG_TOP_K=3
RAG_MAX_TOP_K=8
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=cohere/rerank-v3.5
RAG_RERANK_CANDIDATES=20
RAG_VECTOR_SCORE_THRESHOLD=0.30
RAG_RERANK_SCORE_THRESHOLD=0.30
RAG_GLOBAL_EVIDENCE_LIMIT=6
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_SUBQUERIES=4

# Query planning
RAG_QUERY_PLANNING_ENABLED=true
RAG_QUERY_MODEL=meta-llama/llama-3.1-8b-instruct
RAG_QUERY_TEMPERATURE=0.5
RAG_QUERY_TOP_P=1.0

# Answer generation
RAG_ANSWER_ENABLED=true
RAG_ANSWER_MODEL=deepseek/deepseek-v4-flash
RAG_ANSWER_TEMPERATURE=0.7
RAG_ANSWER_TOP_P=1.0
RAG_ANSWER_MAX_TOKENS=900

# Sufficiency assessment
RAG_SUFFICIENCY_JUDGE_ENABLED=false
RAG_SUFFICIENCY_JUDGE_MODEL=openai/gpt-4o-mini
RAG_SUFFICIENCY_JUDGE_TEMPERATURE=0.5
RAG_SUFFICIENCY_JUDGE_TOP_P=1.0

# Ingestion
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_BATCH_SIZE=32

